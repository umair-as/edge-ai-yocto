# Static UIDs for the edge distro.
#
# Consumed by useradd-staticids.bbclass via USERADD_UID_TABLES in
# conf/distro/edge.conf. Every recipe-driven `useradd` must resolve its
# user against this file; with USERADD_ERROR_DYNAMIC = "error", any
# recipe that introduces a new user not listed here fails the build
# with a clear message naming the missing entry. This is the SBOM /
# CIS-audit guarantee — UIDs are stable across builds and across the
# fleet.
#
# Format: username:password:uid:gid:gecos:home:shell
#  - password is ignored by the class (set via extrausers/usermod -p)
#  - blank fields fall back to the recipe's USERADD_PARAM value
#
# Range policy:
#  - 0-99:    base-passwd (root, daemon, bin, sys, …) — do not touch
#  - 600-699: edge-managed recipe-driven system users
#  - 1000+:   regular users (devel — extrausers, also covered here)
#
# When adding a new system user: pick the next free UID in 600-699,
# mirror the corresponding entry in files/group, and commit both.

weston:*:600:600:Weston compositor:/home/weston:/bin/sh
messagebus:*:601:601:D-Bus system bus:/var/lib/dbus:/bin/false
sshd:*:602:602:OpenSSH server:/var/run/sshd:/bin/false
teesuppl:*:603:603:OP-TEE supplicant:/var/lib/tee:/sbin/nologin
systemd-resolve:*:604:604:systemd Resolver:/:/sbin/nologin
systemd-timesync:*:605:605:systemd Time Synchronization:/:/sbin/nologin
systemd-network:*:606:606:systemd Network Management:/:/sbin/nologin
ota:*:607:607:OTA mTLS user:/nonexistent:/bin/false

# Regular users (created at image-build time via EXTRA_USERS_PARAMS in
# conf/distro/include/edge-users.inc). useradd-staticids rewrites the
# extrausers line too, so listing devel here makes the UID the single
# source of truth — bump it here, the image picks it up automatically.
devel:*:1000:1000:Edge operator:/home/devel:/bin/bash

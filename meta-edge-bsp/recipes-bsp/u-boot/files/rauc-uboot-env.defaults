# Managed U-Boot environment defaults for first-boot migration.
# Format: KEY=VALUE (single line per variable)
#
# RAUC state vars (BOOT_ORDER, BOOT_A_LEFT, BOOT_B_LEFT) are intentionally
# absent here — they are init-only (written if missing, never overwritten) and
# managed directly in rauc-uboot-env-init.sh so that RAUC's slot selection
# (fw_setenv BOOT_ORDER "B A") is never clobbered on OTA boot.
#
# mmc 0 = the active boot device (module microSD when SW1-2=ON, eMMC when
#         SW1-2=OFF). mmc 1 = carrier SD slot, not used for RAUC boot.

loadaddr=0x58000000
splashload=if ext4load mmc 0:1 ${loadaddr} splash.bmp; then true; fi
rauc_init=if test -z "${BOOT_ORDER}"; then setenv BOOT_ORDER "A B"; fi; if test -z "${BOOT_A_LEFT}"; then setenv BOOT_A_LEFT 3; fi; if test -z "${BOOT_B_LEFT}"; then setenv BOOT_B_LEFT 3; fi
rauc_select_slot=setenv rootpartnum; setenv rauc_slot; for BOOT_SLOT in ${BOOT_ORDER}; do if test -n "${rootpartnum}"; then true; elif test "x${BOOT_SLOT}" = "xA"; then if itest ${BOOT_A_LEFT} -gt 0; then setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; setenv rootpartnum 2; setenv rauc_slot A; fi; elif test "x${BOOT_SLOT}" = "xB"; then if itest ${BOOT_B_LEFT} -gt 0; then setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; setenv rootpartnum 3; setenv rauc_slot B; fi; fi; done
rauc_validate_slot=if test -z "${rootpartnum}"; then echo "[RAUC] no bootable slot, resetting counters"; setenv BOOT_A_LEFT 3; setenv BOOT_B_LEFT 3; saveenv; reset; fi
rauc_set_bootargs=setenv bootargs rw rootwait earlycon root=/dev/mmcblk0p${rootpartnum} rauc.slot=${rauc_slot} init_on_alloc=1 init_on_free=1 slab_nomerge page_alloc.shuffle=1 randomize_kstack_offset=on vsyscall=none ${EXTRA_KERNEL_ARGS}; echo "[RAUC] selected slot=${rauc_slot} part=${rootpartnum} (root=/dev/mmcblk0p${rootpartnum})"
# Distro-set kernel cmdline appendix; rauc_set_bootargs appends this verbatim
# to the bootargs string.
#   security=selinux           — activate the LSM (mode in /etc/selinux/config)
#   hash_pointers=always       — hash kernel %p output for everyone, root included
#   hardened_usercopy=1        — runtime copy_{to,from}_user bounds check
#   kfence.sample_interval=100 — KFENCE sampler frequency (also set via Kconfig)
#   proc_mem.force_override=never — block legacy cross-uid /proc/PID/mem write
# lockdown= is deliberately absent — kernel Lockdown LSM at integrity refuses
# to load unsigned modules, and the meta-renesas multimedia modules (mmngr,
# vspm, vspm_if, mmngrbuf) are not signed by this build. See
# docs/security/uboot-hardening.md "U-Boot hardening" deferrals for the
# module-signing infrastructure dependency.
# Recovery escape: fw_setenv EXTRA_KERNEL_ARGS 'selinux=0' disables the LSM.
EXTRA_KERNEL_ARGS=security=selinux hash_pointers=always hardened_usercopy=1 kfence.sample_interval=100 proc_mem.force_override=never
boot_fit=if ext4load mmc 0:1 ${loadaddr} fitImage; then saveenv; bootm ${loadaddr}; fi; echo "[RAUC] fitImage load/boot failed"; reset
bootcmd=if mmc dev 0; then run splashload; run rauc_init; run rauc_select_slot; run rauc_validate_slot; run rauc_set_bootargs; run boot_fit; else reset; fi

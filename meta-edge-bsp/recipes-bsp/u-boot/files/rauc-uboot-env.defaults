# Managed U-Boot environment defaults for first-boot migration.
# Format: KEY=VALUE (single line per variable)
#
# RAUC state vars (BOOT_ORDER, BOOT_A_LEFT, BOOT_B_LEFT) are intentionally
# absent here — they are init-only (written if missing, never overwritten) and
# managed directly in rauc-uboot-env-init.sh so that RAUC's slot selection
# (fw_setenv BOOT_ORDER "B A") is never clobbered on OTA boot.
#
# mmc 0 = the active boot device (module microSD when SW1-2=ON, eMMC when
#         SW1-2=OFF). mmc 1 = carrier SD slot, not used for RAUC boot.

loadaddr=0x58000000
splashload=if ext4load mmc 0:1 ${loadaddr} splash.bmp; then true; fi
rauc_init=if test -z "${BOOT_ORDER}"; then setenv BOOT_ORDER "A B"; fi; if test -z "${BOOT_A_LEFT}"; then setenv BOOT_A_LEFT 3; fi; if test -z "${BOOT_B_LEFT}"; then setenv BOOT_B_LEFT 3; fi
rauc_select_slot=setenv rootpartnum; setenv rauc_slot; setenv verity_ready; for BOOT_SLOT in ${BOOT_ORDER}; do if test -n "${rootpartnum}"; then true; elif test "x${BOOT_SLOT}" = "xA"; then if itest ${BOOT_A_LEFT} -gt 0; then setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; setenv rootpartnum 2; setenv rauc_slot A; setenv verity_ready ${EDGE_VERITY_A}; fi; elif test "x${BOOT_SLOT}" = "xB"; then if itest ${BOOT_B_LEFT} -gt 0; then setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; setenv rootpartnum 3; setenv rauc_slot B; setenv verity_ready ${EDGE_VERITY_B}; fi; fi; done
rauc_validate_slot=if test -z "${rootpartnum}"; then echo "[RAUC] no bootable slot, resetting counters"; setenv BOOT_A_LEFT 3; setenv BOOT_B_LEFT 3; saveenv; reset; fi
rauc_set_legacy_bootargs=setenv bootargs rw rootwait earlycon root=/dev/mmcblk0p${rootpartnum} rauc.slot=${rauc_slot} init_on_alloc=1 init_on_free=1 slab_nomerge page_alloc.shuffle=1 randomize_kstack_offset=on vsyscall=none ${EXTRA_KERNEL_ARGS}; echo "[RAUC] legacy slot=${rauc_slot} part=${rootpartnum}"
# Transitional legacy-slot cmdline appendix. Verity-ready slots take their
# complete command line from the signed FIT DTB.
#   security=selinux           — activate the LSM (mode in /etc/selinux/config)
#   hash_pointers=always       — hash kernel %p output for everyone, root included
#   hardened_usercopy=1        — runtime copy_{to,from}_user bounds check
#   kfence.sample_interval=100 — KFENCE sampler frequency (also set via Kconfig)
#   proc_mem.force_override=never — block legacy cross-uid /proc/PID/mem write
# lockdown= is deliberately absent from the transitional legacy path. The
# verified path takes its complete command line from the signed slot DTB.
# This appendix cannot disable SELinux on a verity-ready slot. Recover those
# slots by booting the other signed slot or installing a newly signed FIT.
EXTRA_KERNEL_ARGS=security=selinux hash_pointers=always hardened_usercopy=1 kfence.sample_interval=100 proc_mem.force_override=never
boot_fit=if test "x${verity_ready}" = "x1"; then if ext4load mmc 0:1 ${loadaddr} fitImage-${rauc_slot}; then setenv bootargs; saveenv; bootm ${loadaddr}#conf-${rauc_slot}; fi; echo "[RAUC] verified slot FIT load/boot failed"; reset; else run rauc_set_legacy_bootargs; if ext4load mmc 0:1 ${loadaddr} fitImage; then saveenv; bootm ${loadaddr}; fi; echo "[RAUC] legacy fitImage load/boot failed"; reset; fi
bootcmd=if mmc dev 0; then run splashload; run rauc_init; run rauc_select_slot; run rauc_validate_slot; run boot_fit; else reset; fi

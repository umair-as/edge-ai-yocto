From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Umair Ahmed Shah <umairahmedshah@hotmail.com>
Date: Sun, 15 Mar 2026 16:40:00 +0000
Subject: [PATCH] smarc-rzv2l: enable FIT signature and bootcount

Upstream-Status: Inappropriate [board-specific configuration]

Enable FIT signature verification related options, keyed autoboot stop
string, bootcount persistence, and hash/RSA support in SMARC RZ/V2L
U-Boot defconfig.

Signed-off-by: Umair Ahmed Shah <umairahmedshah@hotmail.com>
---
Index: git/configs/smarc-rzv2l_defconfig
===================================================================
--- git.orig/configs/smarc-rzv2l_defconfig
+++ git/configs/smarc-rzv2l_defconfig
@@ -5,6 +5,8 @@ CONFIG_ARCH_RENESAS=y
 CONFIG_TEXT_BASE=0x50000000
 CONFIG_ENV_SIZE=0x20000
 CONFIG_ENV_OFFSET=0x1F0000
+CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
+CONFIG_ENV_OFFSET_REDUND=0x210000
 CONFIG_SYS_LOAD_ADDR=0x58000000
 CONFIG_DM_GPIO=y
 CONFIG_RCAR_GEN3=y
@@ -14,11 +16,22 @@ CONFIG_DEFAULT_DEVICE_TREE="smarc-rzv2l"
 CONFIG_SMBIOS_PRODUCT_NAME=""
 CONFIG_SPL=n
 CONFIG_FIT=y
+CONFIG_FIT_SIGNATURE=y
+CONFIG_FIT_VERBOSE=y
+# CONFIG_LEGACY_IMAGE_FORMAT is not set
 CONFIG_SUPPORT_RAW_INITRD=y
 CONFIG_DEFAULT_FDT_FILE="smarc-rzv2l.dtb"
 CONFIG_VERSION_VARIABLE=y
 CONFIG_HUSH_PARSER=y
+CONFIG_BOOTDELAY=3
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_PROMPT="Type 'edge' within %d seconds to stop autoboot\n"
+CONFIG_AUTOBOOT_STOP_STR="edge"
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_ENV=y
 CONFIG_CMD_BOOTZ=y
+# CONFIG_CMD_SOURCE is not set
+CONFIG_CMD_HASH=y
 CONFIG_CMD_GPIO=y
 CONFIG_CMD_I2C=y
 CONFIG_CMD_PART=y

# /etc/fw_env.config
# RZ/V2L SMARC U-Boot environment in MMC raw area.
# Matches smarc-rzv2l_defconfig:
#   CONFIG_ENV_IS_IN_MMC=y
#   CONFIG_ENV_OFFSET=0x1F0000   (1.97MB — raw area before /boot partition)
#   CONFIG_ENV_OFFSET_REDUND=0x210000 (2.06MB — redundant copy)
#   CONFIG_ENV_SIZE=0x20000
#
# IMPORTANT: The /boot partition MUST start at 4MB (--align 4096 in WKS) so
# 0x1F0000 + 0x20000 = 0x210000 (2.06MB) lands safely before p1 at 4MB.
# A 1MB-aligned /boot (--align 1024) puts this offset INSIDE the ext4 partition.
#
# Also requires: FIP in SPI NOR built without "env default -a" in CONFIG_BOOTCOMMAND.
#
# device         offset     env-size
/dev/mmcblk0     0x1F0000   0x20000
/dev/mmcblk0     0x210000   0x20000

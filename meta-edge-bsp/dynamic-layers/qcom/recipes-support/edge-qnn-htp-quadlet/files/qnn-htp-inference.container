[Unit]
Description=Hexagon NPU inference over QNN HTP (rootless, edge-ctr)
# Model (QNN context binary) and inputs live on /data.
After=data.mount
ConditionPathExists=/data/qnn-htp/model/model.bin
ConditionPathExists=/data/qnn-htp/input_list.txt

[Container]
# Supplies only the namespaces: the QNN runtime runs from the host's /usr
# through the host's loader, so its glibc (newer than trixie's) and the
# FastRPC stub match the DSP skels from the same QAIRT build. Interim: host
# glibc 2.43 vs trixie 2.41; replaced by Yocto-built app containers
# (container-base ADR).
Image=docker.io/library/debian:trixie-slim
Pull=missing
Network=none

# FastRPC compute-DSP node (root:fastrpc 0640, opened read-only) and the DMA
# heap the DSP maps buffers from (g:fastrpc ACL). keep-groups carries
# edge-ctr's fastrpc membership into the container.
AddDevice=/dev/fastrpc-cdsp
AddDevice=/dev/dma_heap/system
GroupAdd=keep-groups
# libcdsprpc reads /sys/firmware/devicetree/base/model to pick its
# /usr/share/qcom/conf.d entry and fails device creation without it; podman
# masks /sys/firmware, and a bind mount does not override the mask. /sys stays
# read-only and efivarfs is not mounted inside.
Unmask=/sys/firmware
DropCapability=all
NoNewPrivileges=true

Volume=/usr:/host/usr:ro
Volume=/usr/share/qcom:/usr/share/qcom:ro
Volume=/data/qnn-htp:/qnn-htp:ro
# Output tensors and the profiling log, readable on the host under edge-ctr's
# state directory. qnn-net-run numbers a new profiling log per run when older
# ones exist; they are cleared first so _0 is this run's. The unit's result is
# qnn-net-run's; the profile summary is informational.
Volume=%S/qnn-htp-inference:/out
WorkingDir=/qnn-htp
Exec=/bin/sh -c 'ld=/host/usr/lib/ld-linux-aarch64.so.1; rm -f /out/qnn-profiling-data*.log; \
    "$$ld" --library-path /host/usr/lib /host/usr/bin/qnn-net-run --backend libQnnHtp.so \
        --retrieve_context model/model.bin --input_list input_list.txt --output_dir /out \
        --profiling_level basic --perf_profile burst || exit; \
    "$$ld" --library-path /host/usr/lib /host/usr/bin/qnn-profile-viewer \
        --input_log /out/qnn-profiling-data_0.log | grep -A12 "Execute Stats (Average)"; exit 0'

# Run-once inference; no sd_notify from the runner.
Notify=false

[Service]
Type=oneshot
StateDirectory=qnn-htp-inference

[Install]
WantedBy=default.target

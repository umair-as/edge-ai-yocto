# NM connection profiles + WiFi creds survive RAUC slot swaps.

[Unit]
Description=Persistent NetworkManager state on /data
DefaultDependencies=no
Requires=data.mount
After=data.mount
Before=NetworkManager.service local-fs.target shutdown.target
Conflicts=umount.target shutdown.target

[Mount]
What=/data/nm
Where=/var/lib/NetworkManager
Type=none
Options=bind

[Install]
WantedBy=local-fs.target

# Stable RAUC slot aliases based on partition identity, not filesystem labels.
# This avoids slot lookup failures if ext4 labels change during OTA writes.

SUBSYSTEM=="block", KERNEL=="mmcblk0p1", SYMLINK+="disk/by-rauc-slot/boot"
SUBSYSTEM=="block", KERNEL=="mmcblk0p2", SYMLINK+="disk/by-rauc-slot/rootfsA"
SUBSYSTEM=="block", KERNEL=="mmcblk0p3", SYMLINK+="disk/by-rauc-slot/rootfsB"
SUBSYSTEM=="block", KERNEL=="mmcblk0p4", SYMLINK+="disk/by-rauc-slot/data"

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Umair Ahmed Shah <umairahmedshah@hotmail.com>
Date: Mon, 16 Mar 2026 10:00:00 +0100
Subject: [PATCH] arm64: dts: rzg2l-smarc-som: add local-mac-address placeholders for eth0/eth1

Upstream-Status: Inappropriate [board-specific configuration]

Add zero-filled local-mac-address properties to &eth0 and &eth1 so that
U-Boot's fdt_fixup_ethernet() can populate them with the ethaddr/eth1addr
environment variables at boot time. Without a placeholder property,
fdt_fixup_ethernet() is a no-op and the kernel falls back to random MACs.

---
 arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi b/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi
--- a/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi
+++ b/arch/arm64/boot/dts/renesas/rzg2l-smarc-som.dtsi
@@ -141,6 +141,7 @@
 	phy-handle = <&phy0>;
 	phy-mode = "rgmii-id";
 	status = "okay";
+	local-mac-address = [00 00 00 00 00 00];

 	phy0: ethernet-phy@7 {
 		compatible = "ethernet-phy-id0022.1640",
@@ -168,6 +169,7 @@
 	phy-handle = <&phy1>;
 	phy-mode = "rgmii-id";
 	status = "okay";
+	local-mac-address = [00 00 00 00 00 00];

 	phy1: ethernet-phy@7 {
 		compatible = "ethernet-phy-id0022.1640",
